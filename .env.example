# Google OAuth web client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production redirect URI. For local development use http://localhost:3000/api/gmail/callback
# Production example: https://media-report-kor.vercel.app/api/gmail/callback
GOOGLE_REDIRECT_URI=https://media-report-kor.vercel.app/api/gmail/callback

# Long random secret used to encrypt Gmail refresh/access tokens stored in HttpOnly cookies.
# Generate at least 32 random bytes, e.g. `openssl rand -base64 48`.
GMAIL_TOKEN_SECRET=

# The app only requests Gmail read-only access (gmail.readonly). It cannot send, delete, or modify mail.
